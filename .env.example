# --- Claude (AI) --- read by @anthropic-ai/sdk
# Create a key at https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- WhatsApp Cloud API (Meta for Developers -> your app -> WhatsApp -> API Setup) ---
# Access token. Each client file says which env var holds its token ("tokenEnv"),
# default WHATSAPP_TOKEN. Add more variables here if clients use different tokens.
WHATSAPP_TOKEN=your-whatsapp-access-token
# App settings -> Basic -> App Secret (used to verify the X-Hub-Signature-256 of incoming webhooks)
WHATSAPP_APP_SECRET=your-meta-app-secret
# Any secret string; paste the same value in Meta when configuring the webhook
WHATSAPP_VERIFY_TOKEN=choose-a-verify-token

# --- Business ---
# Fallback number (international format, no "+") that receives lead alerts when a
# client file has an empty "avisos" list, e.g. 13055550100
TELEFONO_DUENO=13055550100

PORT=3000
